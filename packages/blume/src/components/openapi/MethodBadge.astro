---
import { methodStyle } from "../../openapi/display.ts";

interface Props {
  method: string;
  class?: string;
}

const { method, class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center rounded-md px-2 py-0.5 font-mono font-semibold text-xs uppercase tracking-wide",
    methodStyle(method),
    className,
  ]}
>
  {method}
</span>
