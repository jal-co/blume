---
import type { ApiMediaType } from "../../openapi/ir.ts";
import Examples from "./Examples.astro";
import SchemaTree from "./SchemaTree.astro";

interface Props {
  content: ApiMediaType[];
}

const { content } = Astro.props;
---

<div class="not-prose space-y-4">
  {
    content.map((media) => (
      <div>
        {content.length > 1 && (
          <div class="mb-2 font-mono text-muted-foreground text-xs">
            {media.mediaType}
          </div>
        )}
        {media.schema ? (
          <SchemaTree node={media.schema} />
        ) : (
          <p class="text-muted-foreground text-sm">No schema.</p>
        )}
        <Examples examples={media.examples} />
      </div>
    ))
  }
</div>
